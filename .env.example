# sailorguard-push configuration.
# Copy to .env and fill in. .env holds secrets and is ignored by git; never commit it.
# In Portainer, set the same variables as stack environment variables (or upload this file).

# --- Image ------------------------------------------------------------------
# Image built by the GitHub workflow on every merge to main.
IMAGE=ghcr.io/<owner>/sailorguard-push:latest

# --- Apple Push Notification service (iOS) ----------------------------------
# The app's .p8 key from developer.apple.com → Keys, on ONE line with the
# newlines written as \n:
#   -----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
# Alternatively mount the file and set APNS_KEY_FILE instead.
APNS_KEY=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.akat78.sixpack
APNS_HOST=api.push.apple.com

# --- Expo push service (Android) --------------------------------------------
# Access token from expo.dev → Account settings → Access tokens. Required once
# "Enhanced push security" is enabled for the Expo project; leave empty until then.
EXPO_ACCESS_TOKEN=

# --- Admin API --------------------------------------------------------------
# Long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Empty disables /v1/admin/*.
ADMIN_TOKEN=

# --- Service ----------------------------------------------------------------
PORT=8080
DB_FILE=/data/sailorguard-push.db
# 1 = take the client IP from X-Forwarded-For (behind Traefik). Use 0 if exposed directly.
TRUST_PROXY=1

# --- Limits (optional, defaults shown) --------------------------------------
LIMIT_INSTALLATIONS_PER_HOUR=10
LIMIT_HANDLES_PER_HOUR=60
LIMIT_HANDLES_PER_INSTALLATION=50
LIMIT_NOTIFY_BURST=20
LIMIT_NOTIFY_PER_MINUTE=10

# --- Retention in days (optional, defaults shown) ---------------------------
RETAIN_HANDLE_DAYS=120
RETAIN_INVALID_DAYS=30
RETAIN_INSTALLATION_DAYS=365
